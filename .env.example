# Copy to .env and fill in from Supabase: Project Settings -> API.
# The app runs fully offline with these unset: that is the default path,
# not a fallback.
#
# The dashboard shows framework-specific snippets (often Next.js). The VALUES
# are the same whatever framework it displays; only the variable name changes,
# because each build tool exposes env vars under its own prefix. Vite needs
# VITE_. So NEXT_PUBLIC_SUPABASE_URL -> VITE_SUPABASE_URL, and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -> VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=

# The browser-safe key. Supabase renamed this from "anon" to "publishable";
# either name works here. It ships in the browser bundle and is public by
# design - RLS is what protects the data.
VITE_SUPABASE_ANON_KEY=

# NEVER put the secret key (formerly service_role) in this file. It bypasses
# every RLS policy in the project: it is the master key to every child's
# record. It belongs on your machine only, for school onboarding.

# Digits in the sign-in code. Must match Supabase's Email OTP Length
# (Authentication -> Sign In / Providers -> Email). Defaults to 6.
# VITE_OTP_LENGTH=6
