# Copy to .env and fill in from your Supabase project settings.
# The app runs fully offline with these unset — that is the default path,
# not a fallback.
#
# ONLY the anon key belongs here. It ships in the browser bundle and is public
# by design; RLS is what protects the data. The service-role key bypasses every
# policy and must never appear in this file or anywhere under src/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
